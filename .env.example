# TMDB API Token (supports both v4 Read Access Token or v3 API Key)
# Obtain from: https://www.themoviedb.org/settings/api
# - v4 Read Access Token (starts with "eyJ...") is sent as Authorization: Bearer
# - v3 API Key (32-character hex) is passed as api_key by the serverless proxy
# NOTE: Never commit your actual token or credentials to version control.
# Stored as TMDB_TOKEN (non-VITE prefix) so it is accessed securely by the server-side proxy only.
TMDB_TOKEN=your_tmdb_token_or_api_key_here

# Supabase Configuration
# Obtain from: https://supabase.com -> Project Settings -> API
# NOTE: Use the public anon key for VITE_SUPABASE_ANON_KEY. Never expose service_role key to client!
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key_here
